{
  "name": "rover84-linux",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Unofficial Linux tools for the PressPlay Rover 84 V3: Hyprland key remap, backlight control, VIA editor",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "server": "node server/index.ts",
    "start": "npm run build && node server/index.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
